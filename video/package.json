{
  "name": "aria-video",
  "version": "0.1.0",
  "private": true,
  "description": "ARIA's explainer and demo, built with Remotion from a recorded run and the measured results.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AriaDemo out/aria-demo.mp4",
    "stills": "remotion render src/index.ts AriaDemo out/stills --sequence --image-format=png --every-nth-frame=150",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3"
  }
}
