# Copy to .env and fill in what you use. Never commit .env.

# --- deployment --------------------------------------------------------------------------
ARIA_ENV=dev
ARIA_DATABASE_URL=sqlite:///data/aria.db
# Azure SQL (needs the `azure` extra and ODBC Driver 18):
# ARIA_DATABASE_URL=mssql+pyodbc://@<server>.database.windows.net/<db>?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi
ARIA_LOG_FORMAT=console
ARIA_CORS_ORIGINS=http://localhost:3000
# Comma-separated role:key pairs. Roles: viewer, reviewer, admin. Required when ARIA_ENV=prod.
# ARIA_API_KEYS=admin:change-me,reviewer:change-me-too
ARIA_OTEL_EXPORTER=none
# ARIA_OTLP_ENDPOINT=http://localhost:4318
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- NVIDIA NIM (hosted at build.nvidia.com, or self-hosted containers) ------------------
# Get a key: sign in at https://build.nvidia.com, open a model page and choose "Get API Key"
# (keys start with nvapi-). Setting it enables the `nim` provider for every agent role:
# adjudicator, investigator, reporter, critic, comms and Ask ARIA. Check it with:
#   uv run aria providers check nim
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_CHAT_MODEL=openai/gpt-oss-20b
# NVIDIA_NIM_REASONING_EFFORT=low          # empty for models that reject reasoning_effort
# NVIDIA_NIM_FALLBACK_MODEL=minimaxai/minimax-m3.1-flash
# NVIDIA_NIM_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# NVIDIA_NIM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# Reranking (NVIDIA retrieval API on ai.api.nvidia.com) is off until both are set:
# NVIDIA_NIM_RERANK_MODEL=
# NVIDIA_NIM_RERANK_URL=

# --- Azure OpenAI ------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama) -------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=

# --- Periodic log scan (a trigger for incidents no alert caught) -----------------------------
# Every interval ARIA reads the lines appended to each file and opens a run on an error burst.
# ARIA_SCAN_INTERVAL_S=60
# ARIA_SCAN_SOURCES=bgl=/var/log/bgl.log,openssh=/var/log/auth.log

# --- Outbound notifications (sent only after a reviewer approves) ------------------------
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
