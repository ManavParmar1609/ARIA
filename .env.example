# Copy to .env and fill in what you use. Never commit .env.

# --- deployment --------------------------------------------------------------------------
ARIA_ENV=dev
ARIA_DATABASE_URL=sqlite:///data/aria.db
# Azure SQL (needs the `azure` extra and ODBC Driver 18):
# ARIA_DATABASE_URL=mssql+pyodbc://@<server>.database.windows.net/<db>?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi
ARIA_LOG_FORMAT=console
ARIA_CORS_ORIGINS=http://localhost:3000
# Where messages link people to a run: the web console's address.
ARIA_CONSOLE_URL=http://localhost:3000
# Comma-separated name:secret pairs; the name labels the caller in logs and reviews. Every valid
# key can do everything, including reviews. Required when ARIA_ENV=prod.
# ARIA_API_KEYS=ops:change-me,oncall:change-me-too
# Keys each run's pseudonyms (ip-..., email-...), so they stay the same when a run resumes in
# another process or after a restart. Set it wherever more than one process serves ARIA; unset,
# each process makes its own at start.
# ARIA_PSEUDONYM_KEY=
# Behind a reverse proxy, the proxy addresses whose X-Forwarded-For and -Proto to trust (uvicorn's
# own setting). Without it every caller shares the proxy's rate-limit bucket. Avoid "*": uvicorn
# then takes the first address in the header, which the caller writes.
# FORWARDED_ALLOW_IPS=10.0.0.0/8
ARIA_OTEL_EXPORTER=none
# ARIA_OTLP_ENDPOINT=http://localhost:4318
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Google Gemini (free tier available) ---------------------------------------------------
# Get a key at https://aistudio.google.com (API keys). Setting it enables the `gemini` and
# `gemini-lite` providers, which every agent role tries before hosted NIM. On the free tier,
# Google may use prompts to improve its products; ARIA sends only redacted, fenced evidence.
# Check it with:
#   uv run aria providers check gemini
# GEMINI_API_KEY=                           # gemini_api_key (lower case) works too
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# GEMINI_REASONING_EFFORT=minimal           # thinking tokens count against each reply's limit

# --- NVIDIA NIM (hosted at build.nvidia.com, or self-hosted containers) ------------------
# Get a key: sign in at https://build.nvidia.com, open a model page and choose "Get API Key"
# (keys start with nvapi-). Setting it enables the `nim` provider for every agent role:
# adjudicator, investigator, reporter, critic, comms and Ask ARIA. Check it with:
#   uv run aria providers check nim
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_CHAT_MODEL=openai/gpt-oss-20b
# NVIDIA_NIM_REASONING_EFFORT=low          # empty for models that reject reasoning_effort
# NVIDIA_NIM_FALLBACK_MODEL=minimaxai/minimax-m3.1-flash
# NVIDIA_NIM_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# NVIDIA_NIM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# Reranking (NVIDIA retrieval API on ai.api.nvidia.com) is off until both are set:
# NVIDIA_NIM_RERANK_MODEL=
# NVIDIA_NIM_RERANK_URL=
# A self-hosted NIM (the `nim` compose profile) leads every chain once its URL and the model it
# serves are set; `aria providers check nim-local` says what is missing.
# NIM_LOCAL_BASE_URL=http://nim:8000/v1
# NIM_LOCAL_CHAT_MODEL=
# NIM_LOCAL_EMBED_MODEL=
# NIM_LOCAL_RERANK_MODEL=
# NIM_LOCAL_RERANK_URL=

# --- Azure OpenAI ------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_USE_ENTRA=true               # managed identity instead of an API key

# --- Anthropic Claude ----------------------------------------------------------------------
# Get a key at https://console.anthropic.com (API keys). Setting it enables the `claude` provider,
# called through Anthropic's own SDK. Check it with:
#   uv run aria providers check claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low                      # Claude's thinking counts against each reply's limit

# --- OpenAI ----------------------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys. Setting it enables the `openai` provider.
#   uv run aria providers check openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=low

# --- Any other OpenAI-compatible endpoint (vLLM, Ollama, LM Studio) --------------------------
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_CHAT_MODEL=

# --- Visitors' own model keys (public demos) -------------------------------------------------
# Let console visitors paste their own Claude, Gemini, OpenAI or NVIDIA key in Settings. A key is
# used for the visitor's own runs and questions only, held in memory while they run, and never
# stored or logged. Needs ARIA_WORKER_MODE=inprocess (the default).
# ARIA_VISITOR_KEYS=true
# Keep visitors apart on a shared server with no API keys: each sees only the incidents they
# started, plus the examples the server triaged itself, which nobody may change or delete.
# Visitors' runs never join the incident library or the reviews that recalibrate the model.
# ARIA_VISITOR_SCOPE=true

# --- Periodic log scan (a trigger for incidents no alert caught) -----------------------------
# Every interval ARIA reads the lines appended to each file and opens a run on an error burst.
# ARIA_SCAN_INTERVAL_S=60
# ARIA_SCAN_SOURCES=bgl=/var/log/bgl.log,openssh=/var/log/auth.log

# --- Outbound notifications (sent only after a reviewer approves) ------------------------
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# Ticket drafts and other approved actions go to this webhook, signed with the secret:
# ARIA_OUTBOUND_WEBHOOK_URL=
# ARIA_OUTBOUND_WEBHOOK_SECRET=
